{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jtopo:driftwave:schema:filtered_topology",
  "title": "FilteredTopology",
  "description": "L1 artifact — persistent clusters with barcode, distances, and routing decision.",
  "type": "object",
  "required": ["clusters", "barcode", "noise", "routing", "layer"],
  "properties": {
    "layer": { "const": "L1" },
    "timestamp": { "type": "string", "format": "date-time" },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "members", "bar_length"],
        "properties": {
          "id": { "type": "integer" },
          "label": { "type": "string" },
          "members": { "type": "array", "items": { "type": "string" } },
          "bar_length": { "type": ["number", "null"], "description": "Persistence — longer = more real; null when the bar is infinitely persistent (see 'infinite')" },
          "infinite": { "type": "boolean", "description": "true when this cluster's bar never dies (bar_length is null)" },
          "centroid_description": { "type": "string" }
        }
      }
    },
    "barcode": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["birth", "death", "dimension"],
        "properties": {
          "birth": { "type": "number" },
          "death": { "type": ["number", "null"], "description": "null when the bar is infinitely persistent (see 'infinite')" },
          "dimension": { "type": "integer" },
          "infinite": { "type": "boolean", "description": "true when the component never dies (death is null)" }
        }
      }
    },
    "noise": { "type": "array", "items": { "type": "string" } },
    "distances": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "number" } },
      "description": "Pairwise distance matrix for visualization"
    },
    "routing": { "type": "string", "enum": ["ASCEND", "REPROBE", "SPLIT", "HOLD"] },
    "routing_reason": { "type": "string" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "caveat": { "type": "string", "description": "In-band honesty: what this artifact must not be read as (e.g. the dw-bench 'descriptive, not load-bearing' result)" },
    "null_check": {
      "type": "object",
      "description": "Seeded decoy negative control: the same scorer on column-shuffled features. Informational only — a decoy win is necessary, not sufficient, for structure.",
      "properties": {
        "seed": { "type": "integer" },
        "native_top_lifetime": { "type": "number" },
        "decoy_top_lifetime": { "type": "number" },
        "beats_decoy": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "flags": { "type": "array", "items": { "type": "string" }, "description": "Closed significance vocabulary pinned in driftwave.pin.json, enforced by dw_validate" },
    "limits": { "type": "array", "items": { "type": "string" } },
    "not_acceptance": { "type": "boolean" }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": ["producer", "plugin_version", "tier"],
      "properties": {
        "producer": { "type": "string" },
        "plugin_version": { "type": "string" },
        "tier": { "type": "string", "enum": ["real", "heuristic", "planned"] },
        "params": { "type": "object" },
        "feature_basis": { "type": "array", "items": { "type": "string" } },
        "inputs": { "type": "array", "items": { "type": "object", "properties": { "path": { "type": "string" }, "sha256": { "type": "string" } } } },
        "omitted": { "type": "array", "items": { "type": "object", "required": ["stage", "reason"], "properties": { "stage": { "type": "string" }, "reason": { "type": "string" } } } }
      }
    }
  }
}
